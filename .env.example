# Copy to .env.local and fill in the real values. Never commit .env.local.
# Turso database (free tier): turso db create <name>, then
# turso db show <name> --url  and  turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# Video merging service base URL (no keys / no auth).
# The real URL is provided by the service owner; without it merge_videos
# returns a clear error and everything else keeps working.
MERGER_API_BASE=

# Optional: when set, /mcp requires "Authorization: Bearer <token>".
MCP_ACCESS_TOKEN=

# Metricool auto-publishing (REST API v2). All three are required; the token
# is NEVER entered in the dashboard — env vars only.
# - Token: Metricool > Account Settings > API (copy the API access token).
# - userId + brandId (blogId): read them from the brand URL in Metricool, or
#   call GET https://app.metricool.com/api/admin/simpleProfiles?userId=<id>
#   with the X-Mc-Auth header.
# - The REST API needs an Advanced or Custom Metricool plan. Free and Starter
#   plans have NO API access. Without these, publish_video returns a clear
#   "not configured" error and nothing is ever published.
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BRAND_ID=
# Optional IANA timezone used for scheduled_at (default: Africa/Cairo).
METRICOOL_TIMEZONE=

# Optional model-name overrides (defaults are the built-in models).
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
